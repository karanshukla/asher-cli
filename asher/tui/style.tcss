Screen {
    background: $asher-bg;
    color: $asher-fg;
}

/* ── Status bar ── */
#status-bar {
    background: $asher-panel;
    height: 4;
    border-bottom: solid $asher-border;
    dock: top;
    padding: 0;
    layout: vertical;
}

.srow {
    height: 2;
    layout: horizontal;
    align: left middle;
    padding: 0 2;
}

.srow:first-child {
    border-bottom: solid $asher-border;
}

.sep {
    color: $asher-border;
    width: auto;
    height: 1;
    padding: 0 1;
}

.chunk {
    width: auto;
    padding: 0 2 0 0;
    height: 1;
}

/* ── Main ── */
#main-area {
    layout: horizontal;
    height: 1fr;
    layers: base overlay;
}

#log {
    width: 1fr;
    height: 1fr;
    background: $asher-bg;
    padding: 1 2;
    overflow-x: hidden;
    scrollbar-background: $asher-panel;
    scrollbar-color: $asher-border;
    scrollbar-color-hover: $asher-accent;
}

/* ── Slash-command completion overlay ── */
/* overlay: screen floats the widget over #log's last rows without reserving
   layout space, so the log isn't squeezed while the overlay is hidden. */
#completion-overlay {
    layer: overlay;
    overlay: screen;
    dock: bottom;
    min-width: 0;
    height: auto;
    max-height: 8;
    background: $asher-panel;
    border: solid $asher-border;
    padding: 0 1;
    display: none;
}

/* ── Cat panel ── */
#cat-panel {
    width: 30;
    background: $asher-bg;
    border-left: solid $asher-border-subtle;
    align: center middle;
    padding: 1 2;
    height: 1fr;
    layout: vertical;
}

#cat-fx {
    width: 26;
    height: 5;
    color: $asher-accent;
    text-align: center;
    content-align: center middle;
}

#cat-art {
    color: $asher-accent;
    text-align: center;
    width: 26;
    content-align: center middle;
}

#cat-label {
    color: $asher-subtle;
    text-align: center;
    width: 26;
    height: 1;
}

#cat-status {
    width: 26;
    height: auto;
    text-align: left;
    color: $asher-subtle;
}

/* ── Fault banner — inside cat panel, under the status badges ── */
#fault-banner {
    width: 26;
    height: auto;
    text-align: left;
    color: $asher-danger;
    display: none;
}

/* ── Input area (outer dock + hint below the box) ── */
#bottom-dock {
    dock: bottom;
    height: 4;
    background: $asher-panel;
    layout: vertical;
    padding: 0 0 0 0;
}

#input-bar {
    background: $asher-panel;
    height: 3;
    border-top: solid $asher-border;
    border-bottom: solid $asher-border;
    layout: vertical;
    padding: 0 2;
}

#input-row {
    layout: horizontal;
    height: 1;
    align: left middle;
}

#prompt {
    color: $asher-ok;
    width: auto;
    text-style: bold;
    padding: 0 1 0 0;
    height: 1;
}

#hint-bar {
    color: $asher-muted;
    height: 1;
    padding: 0 2;
}

#cmd-input {
    width: 1fr;
    color: $asher-fg-bright;
}
